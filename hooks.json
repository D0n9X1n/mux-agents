{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "sh scripts/mux-agent report working -Quiet",
        "command": "scripts\\mux-agent.cmd report working -Quiet",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "ask_user",
        "bash": "sh scripts/mux-agent report blocked -Kind question -Quiet",
        "command": "scripts\\mux-agent.cmd report blocked -Kind question -Quiet",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "ask_user",
        "bash": "sh scripts/mux-agent report working -Quiet",
        "command": "scripts\\mux-agent.cmd report working -Quiet",
        "timeoutSec": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "matcher": "ask_user",
        "bash": "sh scripts/mux-agent report working -Quiet",
        "command": "scripts\\mux-agent.cmd report working -Quiet",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "sh scripts/mux-agent report idle -Quiet",
        "command": "scripts\\mux-agent.cmd report idle -Quiet",
        "timeoutSec": 10
      }
    ]
  }
}
